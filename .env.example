# This is a sample .env file for the Python assessment project.
# Please fill in your API keys and database credentials below.

MISTRAL_API_KEY=your-mistral-api-key-here

TAVILY_API_KEY=your-tavily-api-key-here
LANGCHAIN_API_KEY=your-langchain-api-key-here
LANGCHAIN_TRACING_V2="true"
LANGCHAIN_PROJECT="your-langchain-project-name"

DB_NAME=your-db-name
DB_USER=your-db-username
DB_PASS=your-db-password
DB_HOST=your-db-host

PD_USERNAME="your-pd-username"
PD_PASSWORD="your-pd-password"
PD_API_BASE_URL="https://your-project-management-api/api"
